{
  "name": "VisiPack",
  "short_name": "VisiPack",
  "description": "Visual node editor for Minecraft Java 26.3+ data packs. Exports a ready-to-use .zip.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#111317",
